# Identification proxy (see proxy/README.md). EXPO_PUBLIC_* values are
# compiled into the app bundle, so these are NOT secrets — the Anthropic API
# key lives only in the proxy (wrangler secret). The app token just keeps
# casual scrapers off the endpoint.
EXPO_PUBLIC_IDENTIFY_URL=http://localhost:8787/identify
EXPO_PUBLIC_APP_TOKEN=change-me
